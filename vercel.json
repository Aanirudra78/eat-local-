{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/restaurant",
      "dest": "/restaurant.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
